{
  "name": "noxarianetapp",
  "version": "1.0.0",
  "description": "NoxarianetApp - Digital Payment & Wallet Platform",
  "main": "server.js",
  "scripts": {
    "build": "npm install",
    "start": "rm -f ppob_visibility.json 2>/dev/null || true; git checkout -f 2>/dev/null || true; git clean -f 2>/dev/null || true; git pull origin main && node server.js",
    "dev": "nodemon server.js",
    "tunnel": "npx localtunnel --port 3006",
    "deploy": "git add . && git commit -m \"update app\" && git push origin main"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "^1.4.0",
    "pino": "^10.3.1",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sqlite3": "^6.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  }
}
